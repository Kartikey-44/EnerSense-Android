<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Cleartext is permitted for local development and the deployed EC2 demo backend:
         10.0.2.2 / 127.0.0.1 / localhost for local dev, and 13.200.250.105 for AWS EC2 demo. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">13.200.250.105</domain>
    </domain-config>
</network-security-config>
