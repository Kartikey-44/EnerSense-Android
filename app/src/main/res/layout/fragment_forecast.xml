<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/swipeRefreshForecast"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    tools:context=".ui.forecast.ForecastFragment">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Title & Subtitle -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tomorrow's Energy Forecast"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/tvForecastHeaderSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your estimated energy usage"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="16dp" />

            <!-- Content Container -->
            <LinearLayout
                android:id="@+id/layoutForecastContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <!-- Hero Forecast Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardHeroForecast"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="@dimen/card_corner_radius"
                    app:cardElevation="@dimen/card_elevation"
                    app:cardBackgroundColor="@color/forecast_blue_subtle"
                    app:strokeColor="@color/forecast_blue_light"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="EXPECTED TOMORROW"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/forecast_blue"
                            android:letterSpacing="0.05" />

                        <!-- Forecast Value & Unit -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="bottom"
                            android:layout_marginTop="12dp">

                            <TextView
                                android:id="@+id/tvForecastValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="--"
                                android:textSize="44sp"
                                android:textStyle="bold"
                                android:textColor="@color/forecast_blue" />

                            <TextView
                                android:id="@+id/tvForecastUnit"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_marginBottom="8dp"
                                android:text="kWh"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_secondary" />
                        </LinearLayout>

                        <!-- Based on recent usage caption -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Based on your recent usage"
                            android:textSize="13sp"
                            android:textColor="@color/text_secondary"
                            android:layout_marginTop="6dp" />

                        <!-- Forecast Target Date secondary label -->
                        <TextView
                            android:id="@+id/tvForecastDate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="--"
                            android:textSize="13sp"
                            android:textColor="@color/text_muted"
                            android:layout_marginTop="2dp" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/forecast_blue_light"
                            android:layout_marginVertical="14dp" />

                        <!-- Consumer Insight Summary -->
                        <TextView
                            android:id="@+id/tvConsumerInsight"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Your energy use is expected to be around -- kWh tomorrow."
                            android:textSize="14sp"
                            android:textColor="@color/text_primary" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Method Transparency Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardForecastExplanation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="@dimen/card_corner_small"
                    app:cardElevation="@dimen/card_elevation"
                    app:cardBackgroundColor="@color/surface_white"
                    app:strokeColor="@color/surface_card_border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="How we estimate this"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="We use your energy consumption from the last 7 days and calculate the average to estimate tomorrow's usage."
                            android:textSize="13sp"
                            android:textColor="@color/text_secondary"
                            android:lineSpacingExtra="4dp"
                            android:layout_marginTop="8dp" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/surface_divider"
                            android:layout_marginVertical="12dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Forecast method"
                                android:textSize="12sp"
                                android:textColor="@color/text_secondary" />

                            <TextView
                                android:id="@+id/tvForecastModel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_forecast_badge"
                                android:paddingHorizontal="10dp"
                                android:paddingVertical="4dp"
                                android:text="7-Day Simple Moving Average"
                                android:textColor="@color/forecast_blue"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- Error / Empty State Container -->
            <LinearLayout
                android:id="@+id/layoutForecastError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="32dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_trending_up"
                    app:tint="@color/text_muted"
                    android:contentDescription="Forecast status" />

                <TextView
                    android:id="@+id/tvForecastEmptyTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No forecast available yet"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:gravity="center"
                    android:layout_marginTop="12dp" />

                <TextView
                    android:id="@+id/tvForecastErrorMessage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Start Live Simulation and collect enough consumption data to generate a forecast."
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary"
                    android:gravity="center"
                    android:lineSpacingExtra="4dp"
                    android:layout_marginTop="6dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnForecastRetry"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginTop="16dp"
                    android:text="Retry"
                    android:textAllCaps="false"
                    app:cornerRadius="10dp"
                    app:backgroundTint="@color/brand_primary" />

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <ProgressBar
        android:id="@+id/progressBarForecast"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="center"
        android:indeterminate="true"
        android:indeterminateTint="@color/forecast_blue"
        android:visibility="gone" />

</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
