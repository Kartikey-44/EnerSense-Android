<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="@dimen/card_corner_small"
    app:cardBackgroundColor="@color/surface_white"
    app:strokeColor="@color/surface_card_border"
    app:strokeWidth="1dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_calendar"
            app:tint="@color/text_secondary"
            android:contentDescription="Date icon" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="14dp">

            <TextView
                android:id="@+id/tvHistoryDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="15 Dec 2016"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/tvRecordSubtext"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Recorded daily total"
                android:textSize="12sp"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvHistoryConsumption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1.53 kWh"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/brand_primary" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
